# Database (SQLite local or PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# NextAuth v5 secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-secure-random-secret"

# Google OAuth Provider
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional: allow passwordless direct login in non-dev environments (keep false in production)
AUTH_ALLOW_DIRECT_LOGIN="false"
