# Imagen de producción (next build + next start).
# Las listas con números de teléfono (/data) y los .env NO entran en la imagen: se montan/pasan al ejecutar.
FROM node:22-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM base AS build
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx prisma generate && NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 npx next build

FROM base AS run
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app ./
EXPOSE 3000
# Crea/actualiza las tablas en la base de producción y arranca
CMD ["sh", "-c", "npx prisma db push --skip-generate && npx next start -H 0.0.0.0 -p 3000"]
