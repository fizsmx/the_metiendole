datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 🔐 Autenticación y Cuentas
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  nickname      String?   @unique
  banner        String?
  bio           String?
  role          String    @default("MEMBER") // ADMIN, MODERATOR, VIP, MEMBER
  points        Int       @default(100)      // Puntos iniciales
  level         Int       @default(1)
  streak        Int       @default(1)
  lastDailyAt   DateTime?
  discordTag    String?
  youtubeHandle String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  giveawayEntries   GiveawayEntry[]
  votes             PollVote[]
  posts             Post[]
  comments          Comment[]
  reactions         Reaction[]
  clips             Clip[]
  clipLikes         ClipLike[]
  pointTransactions PointTransaction[]
  achievements      UserAchievement[]
  redemptions       Redemption[]
}

// ⭐ Puntos y XP
model PointTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  reason      String
  description String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 🎰 Sorteos / Giveaways
model Giveaway {
  id           String   @id @default(cuid())
  title        String
  description  String
  prize        String
  imageUrl     String?
  costPoints   Int      @default(0)
  minLevel     Int      @default(1)
  winnersCount Int      @default(1)
  status       String   @default("ACTIVE") // ACTIVE, DRAWING, FINISHED, CANCELLED
  startsAt     DateTime @default(now())
  endsAt       DateTime
  winnerNames  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries GiveawayEntry[]
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveawayId String
  userId     String
  isWinner   Boolean  @default(false)
  createdAt  DateTime @default(now())

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
}

// 📊 Votaciones / Encuestas
model Poll {
  id          String    @id @default(cuid())
  question    String
  description String?
  category    String    @default("STREAM")
  featured    Boolean   @default(false)
  active      Boolean   @default(true)
  endsAt      DateTime?
  createdAt   DateTime  @default(now())

  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id       String @id @default(cuid())
  pollId   String
  text     String
  order    Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

// 📝 Muro de la Comunidad
model Post {
  id        String   @id @default(cuid())
  userId    String
  content   String
  imageUrl  String?
  category  String   @default("GENERAL") // GENERAL, MEMES, CLIPS, DEBATE, ANUNCIO
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  type      String   // FIRE, HEART, LAUGH, SKULL, ROCKET
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
}

// 🎬 Clips
model Clip {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  videoUrl    String
  thumbnail   String?
  category    String   @default("EPICO")
  isStaffPick Boolean  @default(false)
  createdAt   DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes ClipLike[]
}

model ClipLike {
  id        String   @id @default(cuid())
  clipId    String
  userId    String
  createdAt DateTime @default(now())

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clipId, userId])
}

// 🎯 Logros
model Achievement {
  id           String @id @default(cuid())
  code         String @unique
  title        String
  description  String
  icon         String
  pointsReward Int    @default(50)

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// 🛒 Tienda
model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String
  pricePoints Int
  category    String
  icon        String?
  stock       Int      @default(-1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  redemptions Redemption[]
}

model Redemption {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// 📅 Calendario
model StreamEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  gameTitle   String?
  scheduledAt DateTime
  durationMin Int      @default(120)
  youtubeUrl  String?
  isLive      Boolean  @default(false)
  createdAt   DateTime @default(now())
}
// 🗳️ Votación pública de la final del Gran Sorteo (/votar)
model SorteoPoll {
  id          String       @id @default(cuid())
  optionAId   String // teléfono del finalista A (nunca se envía al público)
  optionAName String
  optionBId   String
  optionBName String
  status      String       @default("open") // open | closed
  createdAt   DateTime     @default(now())
  closedAt    DateTime?
  votes       SorteoVote[]
}

model SorteoVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      SorteoPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  email     String // cuenta de Google que votó
  phone     String // número de WhatsApp del miembro de la comunidad
  choice    String // "A" | "B"
  createdAt DateTime   @default(now())

  // un voto por cuenta de Google y un voto por número
  @@unique([pollId, email])
  @@unique([pollId, phone])
}
